  "extracted_sections": [
    {
      "id": "DOC-DEMO-S001",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "RIVERDALE INSTITUTE OF TECHNOLOGY",
      "text": "MERIT EXCELLENCE SCHOLARSHIP - STANDARD OPERATING PROCEDURE\n(SYNTHETIC SAMPLE DOCUMENT FOR TESTING. NOT A REAL POLICY. ALL DETAILS ARE FICTIONAL.)"
    },
    {
      "id": "DOC-DEMO-S002",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "1. PURPOSE",
      "text": "The Merit Excellence Scholarship supports students of Riverdale Institute of Technology who show strong academic results and need financial help. This document describes how a student applies, how the application is checked, and how the scholarship is awarded."
    },
    {
      "id": "DOC-DEMO-S003",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "2. ELIGIBILITY",
      "text": "Only eligible students may apply for the scholarship. A student must be enrolled in a full-time undergraduate programme at the institute. The student must have a cumulative grade point average (CGPA) of at least 8.0 in the previous academic year. The annual family income of the student must not exceed 5,00,000 rupees. Students who have already received another scholarship from the institute in the same academic year cannot apply."
    },
    {
      "id": "DOC-DEMO-S004",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "3. APPLICATION DEADLINE",
      "text": "Applications must be submitted before 31 March of each year. Applications received after this date will not be accepted."
    },
    {
      "id": "DOC-DEMO-S005",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "4. APPLICATION PROCEDURE",
      "text": "Step 1. The student fills in the online scholarship application form on the institute portal.\n\nStep 2. The student uploads the following documents: the previous year mark sheet, the family income certificate, and a copy of the student identity card.\n\nStep 3. The scholarship clerk checks that the form is complete and that all required documents are attached. Incomplete applications are returned to the student with a note about what is missing.\n\nStep 4. The form is verified.\n\nStep 5. The scholarship clerk checks the documents again and confirms that the mark sheet and the income certificate are genuine.\n\nStep 6. The Head of Department (HOD) reviews each verified application and adds a written recommendation.\n\nStep 7. The Scholarship Committee meets once a year, reviews all recommended applications, and selects the final list of awardees based on merit.\n\nStep 8. The Accounts Office transfers the scholarship amount to the bank account of each selected student."
    },
    {
      "id": "DOC-DEMO-S006",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "5. SCHOLARSHIP AMOUNT",
      "text": "Each selected student receives a scholarship of 40,000 rupees per academic year. The amount is paid in a single instalment."
    },
    {
      "id": "DOC-DEMO-S007",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "6. IMPORTANT DATES",
      "text": "The online application portal opens on 1 February. The last date to submit the scholarship application is 15 April. The Scholarship Committee meets in the first week of June. The final list of awardees is displayed on the institute notice board and portal after the committee meeting."
    },
    {
      "id": "DOC-DEMO-S008",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "7. COMMUNICATION",
      "text": "Students are informed about the result through the portal. Students who are not selected are not sent any separate message."
    },
    {
      "id": "DOC-DEMO-S009",
      "document_id": "DOC-DEMO",
      "page_number": null,
      "section_title": "8. CONTACT",
      "text": "Questions about the scholarship should be sent to the Scholarship Office of the institute."
    }
  ],
